# Where browser-mode student code executes. Must be a DIFFERENT origin from this app:
# the shim over there mints the blob URLs, so they inherit its origin and student code
# cannot reach the playground document.
NUXT_PUBLIC_PREVIEW_ORIGIN=http://preview.localhost:3002

# Where the submit endpoint lives (the admin app).
NUXT_PUBLIC_API_ORIGIN=http://admin.localhost:3001
