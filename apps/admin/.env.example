# Seals the session cookie. At least 32 characters; generate a fresh one per environment.
NUXT_SESSION_PASSWORD=change-me-to-at-least-32-characters-long

# The single admin credential. Unset means every login is refused, never that any
# password works.
NUXT_ADMIN_PASSWORD=change-me

# Origins allowed to POST a submission, comma separated. The playground, nothing else.
NUXT_ALLOWED_ORIGINS=http://play.localhost:3000

# Where the file stores live. In production this MUST be a mounted volume - container
# filesystems are ephemeral and a redeploy would erase every submission.
NUXT_STORAGE_DIR=./.data

# Used to build review links back into the playground.
NUXT_PUBLIC_PLAYGROUND_ORIGIN=http://play.localhost:3000
